<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vibe_cream">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/Theme.Vibe">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/vibe_dark_green"
            app:navigationIcon="@android:drawable/ic_menu_revert"
            app:title="Venue Details"
            app:titleTextColor="@color/vibe_orange" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Banner Placeholder -->
            <View
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="@color/vibe_dark_green" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/tvDetailVenueName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Venue Name"
                    android:textColor="@color/vibe_dark_green"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDetailAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="123 Street Name, Pretoria"
                    android:textColor="@color/vibe_text_muted"
                    android:textSize="16sp"
                    android:layout_marginTop="4dp" />

                <!-- Tags ChipGroup -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupDetailTags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="24dp"
                    android:background="@color/vibe_field_border" />

                <!-- Hours Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hours"
                    android:textColor="@color/vibe_dark_green"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="24dp" />

                <TextView
                    android:id="@+id/tvDetailHours"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Monday - Sunday: 08:00 - 18:00"
                    android:textColor="@color/black"
                    android:textSize="15sp"
                    android:layout_marginTop="8dp" />

                <!-- Description/Match Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Why this matches"
                    android:textColor="@color/vibe_dark_green"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="24dp" />

                <TextView
                    android:id="@+id/tvDetailWhyMatch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="This venue offers the perfect quiet environment for focused work or a peaceful coffee break. With minimal background noise and comfortable seating, it aligns perfectly with your selected vibe."
                    android:textColor="@color/black"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginTop="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveFavorite"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="40dp"
                    android:layout_marginBottom="40dp"
                    android:text="Save to Favorites"
                    android:textColor="@color/vibe_white"
                    android:textStyle="bold"
                    app:backgroundTint="@color/vibe_orange"
                    app:cornerRadius="8dp" />

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/detailProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
