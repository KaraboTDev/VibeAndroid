<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/vibe_white"
    app:strokeColor="@color/vibe_field_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Image Placeholder Box -->
        <View
            android:id="@+id/viewImagePlaceholder"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:background="@color/vibe_dark_green" />

        <!-- Details Box -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvVenueName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Venue Name"
                android:textColor="@color/vibe_dark_green"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvVenueAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="123 Street Name, Pretoria"
                android:textColor="@color/vibe_text_muted"
                android:textSize="14sp"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvVenueHours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Open: 08:00 - 17:00"
                android:textColor="@color/vibe_orange"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />

            <!-- Sync / Extra Status container -->
            <TextView
                android:id="@+id/tvSyncStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Synced"
                android:textColor="#2D6A4F"
                android:textSize="12sp"
                android:textStyle="italic"
                android:layout_marginTop="4dp"
                android:visibility="gone" />

            <!-- Dynamic Tag chips container -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupItemTags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:chipSpacingHorizontal="4dp"
                app:chipSpacingVertical="0dp" />

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
